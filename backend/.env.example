# Backend Environment Configuration
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/finsight

# Security
SECRET_KEY=your-secret-key-here-generate-with-secrets.token_urlsafe(32)
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=0.5

# Server
ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SBERT Model
SBERT_MODEL=all-MiniLM-L6-v2
SBERT_SIMILARITY_THRESHOLD=0.80

# Forensic Analysis
BENFORD_CHI_SQ_THRESHOLD=3.84
ZSCORE_THRESHOLD=3.0
RSF_UPPER_THRESHOLD=3.0
RSF_LOWER_THRESHOLD=0.1

# Budget Forecasting
FORECAST_MONTHS=12
FORECAST_CONFIDENCE_INTERVAL=0.20

# Logging
LOG_LEVEL=INFO

# Rate Limiting (for future use)
RATE_LIMIT_ENABLED=False
RATE_LIMIT_REQUESTS_PER_MINUTE=60
