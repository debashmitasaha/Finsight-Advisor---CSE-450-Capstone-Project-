# Backend Environment Configuration
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/finsight

# Security
SECRET_KEY=your-secret-key-here-generate-with-secrets.token_urlsafe(32)
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=0.5

# Server
ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SBERT Model
SBERT_MODEL=all-MiniLM-L6-v2
SBERT_SIMILARITY_THRESHOLD=0.80

# Forensic Analysis
BENFORD_CHI_SQ_THRESHOLD=3.84
ZSCORE_THRESHOLD=3.0
RSF_UPPER_THRESHOLD=3.0
RSF_LOWER_THRESHOLD=0.1

# Forensic Intelligence Engine - company-specific alert threshold calibration
# These are the DEPLOYMENT DEFAULTS only. A company admin can change them per company
# from the Intelligence Engine page (Calibration settings panel) while the app is
# running; that change is stored in the database and applies at once, so nothing
# here needs editing and the server never needs a restart for a demo.
FORENSIC_BOOTSTRAP_THRESHOLD=60
FORENSIC_MIN_REVIEWED_ROWS=100
FORENSIC_MIN_POSITIVE_LABELS=20
FORENSIC_MIN_NEGATIVE_LABELS=50
FORENSIC_RECALIBRATION_BATCH=100

# Budget Forecasting
FORECAST_MONTHS=12
FORECAST_CONFIDENCE_INTERVAL=0.20

# Logging
LOG_LEVEL=INFO

# Rate Limiting (for future use)
RATE_LIMIT_ENABLED=False
RATE_LIMIT_REQUESTS_PER_MINUTE=60
